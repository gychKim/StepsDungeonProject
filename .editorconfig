root = true

[*.cs]
indent_style = tab
indent_size = tab
end_of_line = lf
charset = utf-8
insert_final_newline = true
csharp_new_line_before_open_brace = all

# 네이밍(요약) — enum 멤버 camelCase 허용
dotnet_naming_rule.enum_members_camel.case = camel_case
dotnet_naming_rule.enum_members_camel.symbols = enum_members
dotnet_naming_rule.enum_members_camel.style = camel_style

dotnet_naming_symbols.enum_members.applicable_kinds = field
dotnet_naming_symbols.enum_members.applicable_accessibilities = *
dotnet_naming_symbols.enum_members.required_modifiers = const

dotnet_naming_style.camel_style.capitalization = camel_case